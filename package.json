{
  "name": "restos-foresight",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "seed": "tsx scripts/seed.ts",
    "typecheck": "tsc --noEmit",
    "demo:reset": "tsx scripts/reset-demo.ts",
    "cache:snapshot": "node -e \"require('fs').copyFileSync('.cache/foresight.json','data/demo-cache.json');console.log('saved data/demo-cache.json')\"",
    "cache:clear": "node -e \"require('fs').rmSync('.cache',{recursive:true,force:true});console.log('cache cleared — restart the dev server')\""
  },
  "dependencies": {
    "@vectorize-io/hindsight-client": "^0.10.1",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
