# Hindsight — Cloud (https://ui.hindsight.vectorize.io → API keys) or self-hosted (http://localhost:8888)
HINDSIGHT_BASE_URL=
HINDSIGHT_API_KEY=
# Optional: change if several people seed the same Hindsight account
HINDSIGHT_BANK_PREFIX=foresight

# Groq (https://console.groq.com/keys) — used for the no-memory baseline and JSON repair
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
